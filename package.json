{
  "name": "clawback",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,api -c yellow,cyan \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "next dev",
    "dev:api": "python3 -m uvicorn api.index:app --reload --port 8001",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m pytest -q",
    "snapshot": "python3 scripts/snapshot_status.py",
    "record": "python3 scripts/record_demo.py http://127.0.0.1:8001"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "^5.3.0",
    "geist": "^1.9.2",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^9.1.0",
    "typescript": "^5.9.0"
  }
}
