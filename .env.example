# Copy to .env.local (Next.js) and export for the API, or paste into Vercel > Settings > Environment Variables.
# Every key is optional. With none set, Clawback runs offline on data/ snapshots.

# --- Cognee (the agent's memory). Ask the Cognee team for a Cloud URL + key, or self-host (docs/BACKEND.md).
COGNEE_URL=
COGNEE_API_KEY=
COGNEE_DATASET=clawback
CLAWBACK_AGENT_KEYS=     # JSON from .clawback-local/agent_keys.json; lets a deploy reuse the agents setup made locally

# --- Claude (reads emails, writes claims). Without it, rules and templates are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Upstash Redis (shared state on Vercel). Add "Upstash for Redis" from the Vercel Marketplace and these fill in.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Switches
CLAWBACK_LIVE_STATUS=1   # fetch status pages live, fall back to data/status snapshots
CLAWBACK_DEMO=0          # 1 = no outside calls at all (snapshots, offline memory, templates)

# --- Frontend
NEXT_PUBLIC_API_BASE=    # empty = same origin. Set to a backend URL if the API is deployed somewhere else.
NEXT_PUBLIC_DEMO=0       # 1 = never call the API; replay data/demo/recorded.json

# --- Slashy (inbox over MCP, P1). Get both from the Slashy team at the event.
SLASHY_MCP_URL=
SLASHY_TOKEN=
